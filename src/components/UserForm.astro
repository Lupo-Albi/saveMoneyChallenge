---
import Input from "./Input.astro";
---

<form class="flex flex-row flex-wrap gap-4" action="/index.html" method="post">
  <Input title="startDate" type="date" />
  <Input title="endDate" type="date" />
  <Input
    title="initialInvestment"
    type="number"
    placeholder="Investimento inicial"
  />
  <Input
    title="investmentInterval"
    type="number"
    placeholder="Intervalo de investimento em dias"
  />
  <Input
    title="increment"
    type="number"
    placeholder="Incremento do investimento"
  />

  <button class="bg-sky-500 hover:bg-sky-700" type="submit">Calcular</button>
</form>
