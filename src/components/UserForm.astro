---
import Input from "./Input.astro";

const { title } = Astro.props;
---

<h1>{title}</h1>

<form action="/index.html" method="post">
  <Input title="startDate" type="date" />
  <Input title="endDate" type="date" />
  <Input title="initialInvestment" type="number" />
  <Input title="investmentInterval" type="number" />
  <Input title="increment" type="number" />

  <button type="submit">Calcular</button>
</form>
