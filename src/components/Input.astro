---
type HTMLInputTypeAttribute =
  | "number"
  | "button"
  | "checkbox"
  | "color"
  | "date"
  | "datetime-local"
  | "email"
  | "file"
  | "hidden"
  | "image"
  | "month"
  | "password"
  | "radio"
  | "range"
  | "reset"
  | "search"
  | "submit"
  | "tel"
  | "text"
  | "time"
  | "url"
  | "week";

interface Props {
  title: string;
  type: HTMLInputTypeAttribute;
  label: string;
  placeholder?: string;
}

const { title, type, placeholder, label } = Astro.props;
---

<div class="flex basis-lg gap-x-10">
  <label class="basis-md" for={title}>{label}</label>
  <input
    class="basis-md"
    name={title}
    id={title}
    type={type}
    placeholder={placeholder}
  />
</div>
