---
type HTMLInputTypeAttribute =
  | "number"
  | "button"
  | "checkbox"
  | "color"
  | "date"
  | "datetime-local"
  | "email"
  | "file"
  | "hidden"
  | "image"
  | "month"
  | "password"
  | "radio"
  | "range"
  | "reset"
  | "search"
  | "submit"
  | "tel"
  | "text"
  | "time"
  | "url"
  | "week";

interface Props {
  title: string;
  type: HTMLInputTypeAttribute;
  placeholder?: string;
}

const { title, type, placeholder } = Astro.props;
---

<input class="basis-lg" name={title} type={type} placeholder={placeholder} />
